package com.example.restbiz;

import java.io.IOException;
import java.net.URI;
import java.net.URLEncoder;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.time.Duration;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.concurrent.atomic.AtomicInteger;

import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.dao.DataAccessException;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class BizController {

    private final JdbcTemplate jdbcTemplate;
    private final ObjectMapper objectMapper;
    private final BizProperties bizProperties;
    private final HttpClient httpClient;
    private final AtomicInteger bomTreeStartIndex = new AtomicInteger(0);

    @Value("${MYSQL_HOST:{{ rest_api_mysql_host }}}")
    private String mysqlHost;

    @Value("${MYSQL_DATABASE:{{ rest_api_mysql_database }}}")
    private String mysqlDatabase;

    public BizController(JdbcTemplate jdbcTemplate, ObjectMapper objectMapper, BizProperties bizProperties) {
        this.jdbcTemplate = jdbcTemplate;
        this.objectMapper = objectMapper;
        this.bizProperties = bizProperties;
        this.httpClient = HttpClient.newBuilder()
                .connectTimeout(Duration.ofSeconds(Math.max(1, bizProperties.getUpstreamTimeoutSeconds())))
                .build();
    }

    @GetMapping("/health")
    public Map<String, Object> health() {
        Map<String, Object> response = new LinkedHashMap<>();
        response.put("status", "ok");
        return response;
    }

    @GetMapping("/db")
    public ResponseEntity<Map<String, Object>> db() {
        try {
            Integer selectOne = jdbcTemplate.queryForObject("SELECT 1", Integer.class);

            Map<String, Object> mysql = new LinkedHashMap<>();
            mysql.put("host", mysqlHost);
            mysql.put("database", mysqlDatabase);
            mysql.put("select_one", selectOne);

            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "ok");
            response.put("mysql", mysql);
            return ResponseEntity.ok(response);
        } catch (DataAccessException exc) {
            Map<String, Object> mysql = new LinkedHashMap<>();
            mysql.put("host", mysqlHost);
            mysql.put("database", mysqlDatabase);
            mysql.put("message", exc.getMessage());

            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "error");
            response.put("mysql", mysql);
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(response);
        }
    }

    @GetMapping("/products")
    public ResponseEntity<Map<String, Object>> products() {
        try {
            List<Map<String, Object>> rows = jdbcTemplate.queryForList(
                    """
                    SELECT DISTINCT
                      p.part_no,
                      p.part_name
                    FROM t_bom b
                    JOIN m_part p
                      ON p.part_id = b.parent_part_id
                    WHERE p.part_name LIKE 'Product-%'
                    ORDER BY p.part_name
                    """);

            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "ok");
            response.put("items", rows);
            return ResponseEntity.ok(response);
        } catch (DataAccessException exc) {
            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "error");
            response.put("message", exc.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(response);
        }
    }

    @GetMapping("/bom-tree")
    public ResponseEntity<Map<String, Object>> bomTree(@RequestParam(name = "part_name", defaultValue = "") String partName) {
        String trimmedPartName = partName.trim();
        if (trimmedPartName.isEmpty()) {
            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "error");
            response.put("message", "part_name is required");
            return ResponseEntity.badRequest().body(response);
        }

        try {
            List<Map<String, Object>> rows = jdbcTemplate.queryForList(
                    """
                    WITH RECURSIVE bom_tree AS (
                      SELECT
                        1 AS lvl,
                        parent.part_id AS root_part_id,
                        parent.part_name AS root_part_name,
                        child.part_id AS child_part_id,
                        child.part_no AS child_part_no,
                        child.part_name AS child_part_name,
                        bi.qty_per_parent,
                        bi.qty_per_parent AS total_qty
                      FROM m_part parent
                      JOIN t_bom b ON b.parent_part_id = parent.part_id
                      JOIN t_bom_item bi ON bi.bom_id = b.bom_id
                      JOIN m_part child ON child.part_id = bi.child_part_id
                      WHERE parent.part_name = ?

                      UNION ALL

                      SELECT
                        bt.lvl + 1,
                        bt.root_part_id,
                        bt.root_part_name,
                        c2.part_id,
                        c2.part_no,
                        c2.part_name,
                        bi2.qty_per_parent,
                        bt.total_qty * bi2.qty_per_parent
                      FROM bom_tree bt
                      JOIN t_bom b2 ON b2.parent_part_id = bt.child_part_id
                      JOIN t_bom_item bi2 ON bi2.bom_id = b2.bom_id
                      JOIN m_part c2 ON c2.part_id = bi2.child_part_id
                    )
                    SELECT
                      lvl,
                      child_part_no,
                      child_part_name,
                      qty_per_parent,
                      total_qty
                    FROM bom_tree
                    ORDER BY lvl, child_part_no
                    """,
                    trimmedPartName);

            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "ok");
            response.put("part_name", trimmedPartName);
            response.put("items", rows);
            return ResponseEntity.ok(response);
        } catch (DataAccessException exc) {
            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "error");
            response.put("part_name", trimmedPartName);
            response.put("message", exc.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(response);
        }
    }

    @GetMapping("/mock-bom")
    public ResponseEntity<Map<String, Object>> mockBom() {
        List<String> bomTreeApiUrls = resolveBomTreeApiUrls();
        int retryLimit = Math.max(1, bizProperties.getBomTreeRetryLimit());
        int baseIndex = Math.floorMod(bomTreeStartIndex.getAndIncrement(), bomTreeApiUrls.size());
        String lastUpstreamError = null;

        try {
            for (int attempt = 1; attempt <= retryLimit; attempt++) {
                int selectedIndex = (baseIndex + attempt - 1) % bomTreeApiUrls.size();
                String selectedBomTreeApiUrl = bomTreeApiUrls.get(selectedIndex);
                String randomDigits = fetchRandomDigits();
                String selectedPartName = "Product-" + randomDigits;

                List<Map<String, Object>> bomItems;
                try {
                    bomItems = fetchBomTreeFromApi(selectedPartName, selectedBomTreeApiUrl);
                } catch (IOException | InterruptedException | RuntimeException exc) {
                    if (exc instanceof InterruptedException) {
                        Thread.currentThread().interrupt();
                    }
                    lastUpstreamError = exc.getMessage();
                    continue;
                }

                if (bomItems == null) {
                    continue;
                }

                Map<String, Object> response = new LinkedHashMap<>();
                response.put("status", "ok");
                response.put("random_digits_api_url", bizProperties.getRandomDigitsApiUrl());
                response.put("bom_tree_api_url", selectedBomTreeApiUrl);
                response.put("bom_tree_api_urls", bomTreeApiUrls);
                response.put("selected_random_digits", randomDigits);
                response.put("requested_bom_part_name", selectedPartName);
                response.put("attempt", attempt);
                response.put("bom_item_count", bomItems.size());
                response.put("bom_items", bomItems);
                return ResponseEntity.ok(response);
            }

            Map<String, Object> response = new LinkedHashMap<>();
            response.put("status", "error");
                response.put("message", lastUpstreamError == null
                    ? "bom-tree not found within retry limit"
                    : "bom-tree lookup failed within retry limit: " + lastUpstreamError);
            response.put("random_digits_api_url", bizProperties.getRandomDigitsApiUrl());
            response.put("bom_tree_api_urls", bomTreeApiUrls);
            response.put("retry_limit", retryLimit);
                return ResponseEntity.status(lastUpstreamError == null ? HttpStatus.NOT_FOUND : HttpStatus.BAD_GATEWAY)
                    .body(response);
        } catch (InterruptedException exc) {
            Thread.currentThread().interrupt();
            return upstreamError(exc);
        } catch (IOException | RuntimeException exc) {
            return upstreamError(exc);
        }
    }

    private ResponseEntity<Map<String, Object>> upstreamError(Exception exc) {
        Map<String, Object> response = new LinkedHashMap<>();
        response.put("status", "error");
        response.put("message", exc.getMessage());
        return ResponseEntity.status(HttpStatus.BAD_GATEWAY).body(response);
    }

    private List<String> resolveBomTreeApiUrls() {
        List<String> urls = new ArrayList<>();
        for (String url : bizProperties.getBomTreeApiUrls()) {
            if (url != null) {
                String trimmed = url.trim();
                if (!trimmed.isEmpty()) {
                    urls.add(trimmed);
                }
            }
        }

        if (urls.isEmpty()) {
            urls.add("{{ rest_api_bom_tree_api_url }}");
        }

        return urls;
    }

    private String fetchRandomDigits() throws IOException, InterruptedException {
        HttpRequest request = HttpRequest.newBuilder(URI.create(bizProperties.getRandomDigitsApiUrl()))
                .timeout(Duration.ofSeconds(Math.max(1, bizProperties.getUpstreamTimeoutSeconds())))
                .GET()
                .build();

        HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
        if (response.statusCode() < 200 || response.statusCode() >= 300) {
            throw new IllegalStateException("random-5digits API returned HTTP " + response.statusCode());
        }

        JsonNode payload = objectMapper.readTree(response.body());
        if (!"ok".equals(payload.path("status").asText())) {
            throw new IllegalStateException("random-5digits API returned non-ok status");
        }

        String randomDigits = payload.path("random_digits").asText("");
        if (randomDigits.length() != 5 || !randomDigits.chars().allMatch(Character::isDigit)) {
            throw new IllegalStateException("random-5digits API returned invalid random_digits");
        }

        return randomDigits;
    }

    private List<Map<String, Object>> fetchBomTreeFromApi(String partName, String bomTreeApiUrl)
            throws IOException, InterruptedException {
        String requestUrl = bomTreeApiUrl + "?part_name=" + URLEncoder.encode(partName, StandardCharsets.UTF_8);
        HttpRequest request = HttpRequest.newBuilder(URI.create(requestUrl))
                .timeout(Duration.ofSeconds(Math.max(1, bizProperties.getUpstreamTimeoutSeconds())))
                .GET()
                .build();

        HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
        if (response.statusCode() == HttpStatus.NOT_FOUND.value()) {
            return null;
        }
        if (response.statusCode() < 200 || response.statusCode() >= 300) {
            throw new IllegalStateException("bom-tree API returned HTTP " + response.statusCode());
        }

        JsonNode payload = objectMapper.readTree(response.body());
        if (!"ok".equals(payload.path("status").asText())) {
            String message = payload.path("message").asText("");
            String normalizedMessage = message.toLowerCase(Locale.ROOT).replace(" ", "");
            if (normalizedMessage.contains("notfound")) {
                return null;
            }
            throw new IllegalStateException("bom-tree API returned non-ok status");
        }

        JsonNode itemsNode = payload.path("items");
        if (!itemsNode.isArray() || itemsNode.isEmpty()) {
            return null;
        }

        return objectMapper.convertValue(itemsNode, new TypeReference<List<Map<String, Object>>>() {});
    }
}