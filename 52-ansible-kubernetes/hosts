master ansible_host=master ansible_user=ubuntu ansible_become=true
node1  ansible_host=node1  ansible_user=ubuntu ansible_become=true
node2  ansible_host=node2  ansible_user=ubuntu ansible_become=true
node3  ansible_host=node3  ansible_user=ubuntu ansible_become=true

[masters]
master

[nodes]
node1
node2
node3


[all:vars]
cluster_name        =   "k8s1"
cluster_admin       =   "ubuntu"

nfs_share_dir       =   "/mnt"
temp_dir            =   "/tmp"

k8s_version         =   "1.36"
k8s_version_patch   =   "{{ k8s_version }}.2"
k8s_package_version =   "{{ k8s_version_patch }}-2.1"
#k8s_apiserver       =   "{{ hostvars['master'].ansible_host }}"
k8s_metrics_server  =   "v0.8.1"

containerd_version  =   "2.3.1"
runc_version        =   "v1.4.3"
cni_plugins         =   "v1.6.0"
crictl_version      =   "v1.36.0"


helm_version        =   "v4.2.1"
flannel_version     =   "v0.12.0"
calico_version      =   "v3.29.3"
iface_pri           =   "enp2s0"
cpu_arch            =   "amd64"

# CNI         CIDR
# Calico     192.168.0.0/16
# Flannel     10.244.0.0/16
# Cilium      10.0.0.0/8
# Weave       10.32.0.0/12

pod_cidr            = "10.12.0.0/16"
#pod_cidr            = "10.244.0.0/16"

# Ceph CSI (56-ceph-single-node で構築したCephクラスタの情報に置き換えること)
# 取得方法・作成手順は playbooks/addon_ceph-csi/README.md を参照
ceph_cluster_id     = "<ceph fsid>"
ceph_monitors       = ["192.168.1.230:6789"]

ceph_rbd_pool       = "k8s-rbd-pool"
ceph_rbd_user_id    = "k8s"
ceph_rbd_user_key   = "<ceph auth print-key client.k8s>"

ceph_fs_name        = "cephfs"
ceph_fs_user_id     = "k8s"
ceph_fs_user_key    = "<ceph auth print-key client.k8s>"
