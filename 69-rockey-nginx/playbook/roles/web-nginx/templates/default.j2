# HTTP (ポート80) の設定: すべてのアクセスをHTTPSにリダイレクト
server {
    listen 80;
    server_name {{ cert_basename }};

    return 301 https://$host$request_uri;
}

# HTTPS (ポート443) の設定
server {
    listen 443 ssl;
    server_name labo.local {{ cert_basename }};

    # 証明書と秘密鍵のパスを指定
    ssl_certificate {{ nginx_cert_dir }}/{{ cert_basename }}.crt;
    ssl_certificate_key {{ nginx_cert_dir }}/{{ cert_basename }}.key;

    # 推奨されるTLSプロトコルと暗号化スイートの設定（セキュリティ強化）
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # ドキュメントルートなどの基本設定
    root {{ nginx_doc_root }};
    index index.html index.htm;

}
