# Garage S3 API の TLS 終端 (managed by Ansible)
server {
    listen {{ s3_tls_port }} ssl http2;
    listen [::]:{{ s3_tls_port }} ssl http2;
    server_name {{ s3_tls_server_names | join(' ') }};

    ssl_certificate     {{ s3_tls_dir }}/server.crt;
    ssl_certificate_key {{ s3_tls_dir }}/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 大きなオブジェクトのアップロードを許可し、バッファリングしない
    client_max_body_size    0;
    proxy_request_buffering off;
    proxy_buffering         off;

    location / {
        proxy_pass {{ s3_tls_upstream }};
        # SigV4 署名はホスト名を含むため、元の Host をそのまま渡す
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
{% if s3_tls_ui_enabled %}

# garage-ui の TLS 終端。管理トークンを暗号化して送るため
server {
    listen {{ s3_tls_ui_port }} ssl http2;
    listen [::]:{{ s3_tls_ui_port }} ssl http2;
    server_name {{ s3_tls_server_names | join(' ') }};

    ssl_certificate     {{ s3_tls_dir }}/server.crt;
    ssl_certificate_key {{ s3_tls_dir }}/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # クッキーはポートを区別せず共有されるため、同じホスト名の他サービスのクッキーでヘッダが大きくなる
    large_client_header_buffers 4 32k;

    # http:// で 8443 にアクセスしたときの 400 を https:// への転送にする
    error_page 497 =301 https://$host:$server_port$request_uri;

    location / {
        proxy_pass {{ s3_tls_ui_upstream }};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
{% endif %}
