; Managed by Ansible
$TTL 3600
@   IN  SOA ns1.{{ dns_domain }}. root.{{ dns_domain }}. (
            {{ dns_zone_serial }} ; serial
            1800       ; refresh
            3600       ; retry
            604800     ; expire
            1800 )     ; negative cache TTL

{% for ns in dns_ns_servers %}
@   IN  NS  {{ ns }}.{{ dns_domain }}.
{% endfor %}

{% for r in dns_a_records if (r.ptr | default(true)) and r.ip.startswith(item.prefix ~ '.') %}
{{ r.ip[(item.prefix | length + 1):].split('.') | reverse | join('.') }}    IN  PTR {{ r.name }}.{{ dns_domain }}.
{% endfor %}
