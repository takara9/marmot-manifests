; Managed by Ansible
$TTL 3600
@   IN  SOA ns1.{{ item }}. root.{{ item }}. (
            {{ dns_zone_serial }} ; serial
            1800       ; refresh
            3600       ; retry
            604800     ; expire
            1800 )     ; negative cache TTL

{% for ns in dns_ns_servers %}
@   IN  NS  {{ ns }}.{{ item }}.
{% endfor %}
{% for m in dns_mx_records %}
@   IN  MX  {{ m.priority }} {{ m.target }}.{{ item }}.
{% endfor %}

{% for r in dns_a_records %}
{{ r.name }}    IN  A   {{ r.ip }}{% if r.comment is defined %}   ; {{ r.comment }}{% endif %}

{% endfor %}

{% for r in dns_cname_records %}
{{ r.name }}    IN  CNAME   {{ r.target }}.{{ item }}.
{% endfor %}
