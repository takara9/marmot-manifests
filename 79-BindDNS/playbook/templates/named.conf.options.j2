// Managed by Ansible
include "{{ bind_conf_dir }}/xfr.key";

// オープンリゾルバー対策: 問い合わせ・再帰は信頼するネットワークのみ許可する
acl "trusted" {
    localhost;
{% for n in dns_trusted_networks %}
    {{ n }};
{% endfor %}
};

options {
    directory "{{ bind_cache_dir }}";

    listen-on { {% for a in dns_listen_addresses %}{{ a }}; {% endfor %}};
    listen-on-v6 { none; };

    version "none";
    allow-query { trusted; };
    allow-query-cache { trusted; };
    recursion yes;
    allow-recursion { trusted; };
    max-cache-size {{ dns_max_cache_size }};

{% if dns_is_primary | bool %}
    // ゾーン転送は TSIG 鍵で認証する。CoreDNS(ns3) は TSIG 非対応のため IP で許可する
    allow-transfer { key {{ dns_tsig_key_name }}; {% for a in dns_ip_secondary_ips %}{{ a }}; {% endfor %}};
    notify yes;
    also-notify { {% for a in dns_secondary_ips + dns_ip_secondary_ips %}{{ a }}; {% endfor %}};
{% else %}
    allow-transfer { none; };
    notify no;
    allow-notify { {{ dns_primary_ip }}; };
{% endif %}

    forwarders { {% for f in dns_forwarders %}{{ f }}; {% endfor %}};
    forward first;

    dnssec-validation auto;
    // 非公開ドメインは署名されていないため検証から除外する
    validate-except { {% for d in dns_domains %}"{{ d }}"; {% endfor %}};
};

{% if dns_is_primary | bool %}
server {{ dns_secondary_ips[0] }} {
    keys { {{ dns_tsig_key_name }}; };
};
{% else %}
server {{ dns_primary_ip }} {
    keys { {{ dns_tsig_key_name }}; };
};
{% endif %}

statistics-channels {
    inet 127.0.0.1 port 8053 allow { 127.0.0.1; };
};
